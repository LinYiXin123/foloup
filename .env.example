NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up 
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard 
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard 
# 候选人分享地址；留空跟随当前访问地址。正式部署可填写固定 HTTPS 公网网址。
NEXT_PUBLIC_LIVE_URL=

# Clerk
# 登录方式：clerk 或 feishu。飞书模式不需要 Clerk 凭证。
AUTH_PROVIDER=clerk
AUTH_URL=http://localhost:3000
# 至少 32 位的随机会话密钥，仅放服务端
AUTH_SESSION_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 迁移旧工作区时填写账号绑定 JSON，见 docs/feishu-login.md；不要提交真实值
FEISHU_USER_BINDINGS={}

# Clerk（使用原有登录方式时填写）
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret: never prefix it with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Retell AI
RETELL_API_KEY=

# OpenAI
OPENAI_API_KEY=
# 留空使用官方接口；兼容接口请填写包含 /v1 的地址
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
